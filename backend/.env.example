# UndreoCol backend — variables de entorno (nunca valores reales aquí).
#
# En local se copian a backend/.dev.vars (gitignored) con los valores reales
# que imprime `supabase start` (claves sb_publishable_/sb_secret_).
# En producción: [vars] + `wrangler secret put` (las pone Mateo).

# Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# CORS — orígenes permitidos para el frontend, separados por coma
ALLOWED_ORIGIN=http://localhost:3000

# Reservado para la sesión del suscriptor (feature 008, D-2/D-4). No se usa aún.
SESSION_SECRET=
